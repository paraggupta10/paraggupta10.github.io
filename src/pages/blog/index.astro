---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE } from "../../consts";

const base = import.meta.env.BASE_URL;

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const title = `Blog — ${SITE_TITLE}`;
const description = "Technical writing from Parag Gupta on DevOps, SRE, infrastructure automation, and AI-augmented observability tooling.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main>
    <section class="section">
      <div class="wrapper">
        <h1>Blog</h1>
        <p class="muted">
          Technical notes on infrastructure, automation, and building tools
          that stay useful even when the AI layer isn't available.
        </p>

        <ul class="post-list">
          {
            posts.map((post) => (
              <li class="post-item">
                <a href={`${base}blog/${post.id}/`}>
                  <h2 class="post-title">{post.data.title}</h2>
                </a>
                <span class="post-date">{dateFormatter.format(post.data.date)}</span>
                <p class="post-excerpt">{post.data.excerpt}</p>
                <div class="post-tags">
                  {post.data.tags.map((tag: string) => <span class="post-tag">{tag}</span>)}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
