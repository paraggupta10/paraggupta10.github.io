---
import { SOCIAL_LINKS } from "../consts";
---

<section class="section" id="contact">
  <div class="wrapper">
    <h2 class="section-title">Get in Touch</h2>
    <p class="muted">
      Open to conversations about DevOps, SRE, and infrastructure automation.
      Reach out through any of the channels below.
    </p>
    <div class="social-row">
      <a href={`mailto:${SOCIAL_LINKS.email}`}>Email</a>
      <a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
</section>
